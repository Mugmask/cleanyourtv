<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream): the theme's wallpaper with a bold clock and the date in the bottom right
     corner. Without a wallpaper, black under an ambient glow. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <View
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/dreamPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <View
        android:id="@+id/dreamShade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/dream_shade"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#F2FFFFFF"
                android:textSize="110sp"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="-0.03"
                android:includeFontPadding="false" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="#99FFFFFF"
                android:textSize="22sp"
                android:fontFamily="@font/inter_medium"
                android:letterSpacing="0.08"
                android:textAllCaps="true" />
        </LinearLayout>

        <!-- "Mié 21 Oct", set by ClockScene. The negative margin takes back the space Inter leaves under the
             large digits (they have no descenders), so the date sits right under the clock. -->
        <TextView
            android:id="@+id/dreamDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-16dp"
            android:layout_marginEnd="12dp"
            android:textColor="#CCFFFFFF"
            android:textSize="26sp"
            android:fontFamily="@font/inter_medium"
            android:includeFontPadding="false" />
    </LinearLayout>
</FrameLayout>
