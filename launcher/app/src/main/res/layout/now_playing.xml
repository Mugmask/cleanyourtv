<?xml version="1.0" encoding="utf-8"?>
<!-- NowPlaying: artwork, what is playing and previous / play-pause / next, above the dock. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nowPlaying"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="58dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/np_card_bg"
    android:padding="14dp"
    android:visibility="gone">

    <ImageView
        android:id="@+id/npArt"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/npApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/inter_medium"
            android:singleLine="true" />

        <TextView
            android:id="@+id/npTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="380dp"
            android:layout_marginTop="2dp"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:fontFamily="@font/inter_semibold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/npArtist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="380dp"
            android:textColor="#B3FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/inter_regular"
            android:singleLine="true"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/npPrev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="11dp"
                android:src="@drawable/ic_skip_previous"
                android:tint="@drawable/pill_text"
                android:background="@drawable/np_button_bg"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@string/media_previous" />

            <ImageView
                android:id="@+id/npPlay"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:padding="11dp"
                android:src="@drawable/ic_play"
                android:tint="@drawable/pill_text"
                android:background="@drawable/np_button_bg"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@string/media_play" />

            <ImageView
                android:id="@+id/npNext"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:padding="11dp"
                android:src="@drawable/ic_skip_next"
                android:tint="@drawable/pill_text"
                android:background="@drawable/np_button_bg"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@string/media_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
